# Copy to .env.production on the server (never commit it). Every value is required
# unless marked optional. docs/deploy.md explains where each one comes from.

# Your site's address, e.g. https://fieldtested.in  (TODO(uma): the real domain)
SITE_URL=https://example.com

# Database password. Make a long random one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install command)
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Turnstile (Dashboard > Turnstile > Add widget). Optional but recommended.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: form posts allowed per visitor per minute (default 6)
# FORM_POSTS_PER_MINUTE=6

# Admin area (/admin): the argon2id hash from `pnpm admin:password` (copy the line it
# writes to api/.env on your laptop; keep the single quotes). Without it, /admin
# shows "Admin not set up yet". ADMIN_ORIGINS is the site's own address (defaults to SITE_URL).
ADMIN_PASSWORD_HASH=
# ADMIN_ORIGINS=https://your-domain.example

# Optional: where nightly backups go on the server (default /var/backups/field-tested)
# BACKUP_DIR=/var/backups/field-tested
