{
  "name": "field-tested",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd api && cargo run",
    "dev:web": "pnpm --dir web dev",
    "types": "cd api && cargo test",
    "test": "cd api && cargo test && cd ../web && pnpm test:screens",
    "check": "pnpm --dir web lint && pnpm --dir web exec tsc --noEmit && cd api && cargo clippy -- -D warnings",
    "db:up (phase 8)": "docker compose up -d --wait db"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "concurrently": "^9.2.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.5.2"
}
