{
  "name": "field-tested",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n db,web -c gray,cyan \"pnpm db:wsl\" \"pnpm dev:web\"",
    "dev:windows": "concurrently -k -n db,web -c gray,cyan \"pnpm db\" \"pnpm dev:web\"",
    "dev:web": "pnpm --dir web dev -p 3001",
    "db:wsl": "node scripts/wsl.mjs db",
    "db": "node scripts/db.mjs test",
    "db:docker": "docker compose up -d --wait db",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:sql": "node scripts/export-sql.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "test": "cd web && pnpm test:unit && pnpm test:screens",
    "check": "pnpm --dir web lint && pnpm --dir web exec tsc --noEmit",
    "legacy:api": "node scripts/wsl.mjs cargo run"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.23.0"
  },
  "packageManager": "pnpm@11.5.2"
}
