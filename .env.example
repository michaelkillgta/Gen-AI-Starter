# Copy to .env (repo root) and api/.env. Local development values only.

# --- API (Rust/Axum) ---
DATABASE_URL=postgres://fieldtested:fieldtested_dev@localhost:5433/fieldtested
API_BIND=127.0.0.1:8080
CORS_ORIGINS=http://localhost:3000
RUST_LOG=api=debug,tower_http=info
# Where form submissions are stored until the database (phase 8). Gitignored.
# DATA_DIR=./data
FORM_POSTS_PER_MINUTE=6
# Cloudflare Turnstile secret. Leave empty locally (bot check off).
# Cloudflare's always-pass test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# --- Web (Next.js) ---
# Server-side calls from Next.js to the API
API_URL=http://127.0.0.1:8080
# Public site address (used for sitemap, RSS, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key. Leave empty locally.
# Cloudflare's always-pass test site key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
