# Copy to web/.env.local. Local development values only.
# On Vercel, set the same names under Project > Settings > Environment Variables.

# The database. Locally: the one `pnpm dev` starts (or `pnpm db:docker`).
# On Supabase: Project > Connect > "Transaction pooler" connection string (port 6543).
# Optional: put the password here instead of inside the link.
# DATABASE_PASSWORD=
DATABASE_URL=postgres://fieldtested:fieldtested_dev@localhost:5433/fieldtested
# Optional: form posts allowed per visitor per minute (default 6)
# FORM_POSTS_PER_MINUTE=6

# Admin area (/admin). Don't type this yourself: run `pnpm admin:password`, which
# writes the argon2id hash (never the password) here, base64-encoded.
# On Vercel, paste the same value it prints.
# ADMIN_PASSWORD_HASH=JGFyZ29uMmlk...

# Public site address (used for sitemap, RSS, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile secret, checked by the website's server. Leave empty locally (bot check off).
# Cloudflare's always-pass test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
# Cloudflare Turnstile site key. Leave empty locally.
# Cloudflare's always-pass test site key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
